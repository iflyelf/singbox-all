# =============================================================================
# vmess / trojan WebSocket 反向代理  (模板, 由 docker-entrypoint.sh 渲染)
#   占位符: __NGINX_LISTEN__ / __VMESS_PORT__ / __TROJAN_PORT__
#           __VMESS_WSPATH__ / __TROJAN_WSPATH__
#   NGINX_LISTEN=127.0.0.1 时仅本机(供 cloudflared 回源); 0.0.0.0 时开放公网直连
# =============================================================================

# 上游: 同容器内 sing-box 监听端口
upstream vmess  { server 127.0.0.1:__VMESS_PORT__ max_fails=0 fail_timeout=0; }
upstream trojan { server 127.0.0.1:__TROJAN_PORT__ max_fails=0 fail_timeout=0; }

server {
    listen __NGINX_LISTEN__:80;
    server_name _;
    charset utf-8;

    include cache.conf;

    root /www;
    index index.html index.htm;

    access_log logs/default.log combined;
    error_log  logs/default.log error;

    # vmess WebSocket (path 与 sing-box 服务端一致, 不 strip 前缀)
    location = __VMESS_WSPATH__ {
        include websocket.conf;
        proxy_pass http://vmess;
        access_log logs/xiaonuo.log combined;
        error_log  logs/xiaonuo.log error;
    }

    # trojan WebSocket
    location = __TROJAN_WSPATH__ {
        include websocket.conf;
        proxy_pass http://trojan;
        access_log logs/xiaonuo.log combined;
        error_log  logs/xiaonuo.log error;
    }

    # 隐藏敏感文件
    location ~ /\. { deny all; }
}
