# =============================================================================
# singbox-all 环境变量模板
#   复制为 .env 后按需修改: cp .env.example .env
#   注意: compose 使用 host 网络模式, conduitvpn 以 NETWORK_MODE=host 运行。
#         各服务监听地址 (NGINX_LISTEN / UI_HOST / LOCAL_PROXY_HOST) 默认均为
#         127.0.0.1 (仅本机可达), 不对公网暴露任何端口; 需要时可在下方按需放开。
# =============================================================================

# ---- vmess ----
VMESS_PORT=6601
VMESS_NAME=xiaonuo
VMESS_UUID=f011c012-5f1d-418c-9494-d24d77a9d8f9
VMESS_ALTER_ID=0
VMESS_WSPATH=/xiaonuo/vmess

# ---- trojan ----
TROJAN_PORT=6602
TROJAN_NAME=xiaonuo
TROJAN_PWD=ysyh!9Sky
TROJAN_WSPATH=/xiaonuo/trojan

# ---- conduitvpn 运行模式 ----
# host 网络模式下必须为 host (socket 标记路由, 从不改宿主机默认路由)
# 独立 bridge 网络时用 container (全隧道 redirect-gateway)
NETWORK_MODE=host

# ---- conduitvpn 管理台 (密码必须 >=16 字符) ----
UI_USER=admin
UI_PASSWORD=Chqmyg#2024Moon!
# 管理台监听地址: 默认 127.0.0.1 仅本机可达, 不暴露任何公网端口 (host 模式最安全).
#   外部访问方式: 通过 cloudflared 命名隧道把子域指向 http://127.0.0.1:8787
#   (见下方 TUNNEL_TOKEN / CF_TUNNEL_UI_HOSTNAME 说明). 如确需直接公网暴露, 改为 0.0.0.0 并自行配置防火墙.
UI_HOST=127.0.0.1

# ---- conduitvpn 本地代理 (sing-box 出站经此走住宅IP; 密码必须 >=16 字符) ----
# 仅供本机 sing-box 出站调用, 保持 127.0.0.1 即可 (无需外部访问)
LOCAL_PROXY_HOST=127.0.0.1
LOCAL_PROXY_PORT=7928
LOCAL_PROXY_USER=proxy
LOCAL_PROXY_PASS=Chqmyg#2024Moon!

# ---- sing-box 出站策略 ----
# direct: 纯直连, 直接走本机线路, 完全不经 conduitvpn/VPNGate (默认)
#         ⚠️ 出站为本机公网IP, 不是住宅IP
# none  : 只走 conduitvpn 住宅IP; VPNGate 不可用时连接失败, 不泄漏主机IP
# 不填写时默认为 direct (纯直连)
SINGBOX_FALLBACK=direct

# ---- hysteria2 关闭 (UDP 无法经 Cloudflare Tunnel; host 模式也不支持) ----
HY2_PORT=0

# ---- nginx 监听地址与端口 (host 网络模式) ----
# NGINX_LISTEN: 监听地址
#   127.0.0.1 : 仅本机可达, 公网走 cloudflared 隧道回源 (默认, 无需防火墙)
#   0.0.0.0   : 开放公网直连 (⚠️ 需自行配置防火墙; 直连时记得设置 LINK_DOMAIN)
NGINX_LISTEN=127.0.0.1

# NGINX_PORT: HTTP 对外监听端口, 与宿主机其他服务冲突时可改
#   Cloudflare 支持回源/代理的 HTTP 端口:
#     80  8080  8880  2052  2082  2086  2095
#   cloudflared 隧道回源地址默认跟随此 HTTP 端口, 无需另外配置
NGINX_PORT=80

# NGINX_HTTPS_PORT: HTTPS 对外监听端口, 0 表示不启用 HTTPS
#   Cloudflare 支持回源/代理的 HTTPS 端口:
#     443  2053  2083  2087  2096  8443
NGINX_HTTPS_PORT=0

# ---- HTTPS 证书 (NGINX_HTTPS_PORT != 0 时生效) ----
# 证书目录结构: conf/nginx/ssl/<SSL_DOMAIN>/
#   <SSL_DOMAIN>.pem            站点证书 (Cloudflare Origin CA 等)
#   <SSL_DOMAIN>.key            站点私钥
#   origin_ca_rsa_root.pem      CA 根证书
#   origin-pull-ca.pem          Authenticated Origin Pull 客户端 CA (可选)
#
# 换域名: 改 SSL_DOMAIN, 并把证书放到 conf/nginx/ssl/<新域名>/ 下
SSL_DOMAIN=xiaonuo.live
#
# 挂载替换证书 (推荐, 无需重建镜像): 在 docker-compose.yml 增加
#   volumes:
#     - ./conf/nginx/ssl:/data/nginx/conf/ssl:ro
# 或指定其他目录后同步修改 SSL_BASE_DIR
SSL_BASE_DIR=/data/nginx/conf/ssl
#
# 证书文件名 (默认与域名同名; 签发机构命名不同时可单独覆盖)
# SSL_CERT_FILE=xiaonuo.live.pem
# SSL_KEY_FILE=xiaonuo.live.key
# SSL_TRUSTED_FILE=origin_ca_rsa_root.pem
# SSL_CLIENT_CA_FILE=origin-pull-ca.pem
#
# Cloudflare Authenticated Origin Pull: on 时仅允许 CF 边缘回源
SSL_VERIFY_CLIENT=off

# ---- cloudflared ----
# 留空: quick tunnel (随机 trycloudflare.com 域名, 每次重启变化)
# 填值: 命名隧道 (固定域名, 需在 Cloudflare Zero Trust 面板配置 ingress)
#
# 访问 conduitvpn 管理台 (UI_HOST=127.0.0.1 不开放公网时):
#   在 Cloudflare Zero Trust > 该隧道 > Public Hostname 增加一条 ingress:
#     - 代理流量: <你的域名>            -> http://127.0.0.1:80    (nginx 反代 vmess/trojan)
#     - 管理台:   admin.<你的域名>      -> http://127.0.0.1:8787  (conduitvpn UI)
#   建议再给管理台子域套一层 Cloudflare Access (邮箱/OTP) 做二次鉴权.
TUNNEL_TOKEN=

# ---- 链接生成: 隧道域名 ----
# 留空: 自动从 cloudflared 日志抓取 quick tunnel 域名
# 填固定域名 (命名隧道时): 优先使用此值生成分享链接/订阅
# 此域名用于链接中的 host / sni (WebSocket 路由必需, 不能随意改)
LINK_DOMAIN=

# ---- 链接生成: 优选域名 (Cloudflare 优选 IP) ----
# 留空: 连接地址与隧道域名相同
# 填值: 链接中的连接地址 (vmess add / trojan server) 使用此优选域名,
#       而 host / sni 仍为上面的真实隧道域名, 从而走 Cloudflare 优选 IP 提速。
#       该域名需已 CNAME 或 A 记录指向你选定的 Cloudflare 优选 IP。
# 例如: PREFER_DOMAIN=cf.xiaonuo.live
PREFER_DOMAIN=

# ---- WAF 放行域名 (逗号分隔, DetectionOnly 放行, 避免误拦代理流量) ----
# trycloudflare.com 已固定放行; 此处追加自定义域名, 例如:
# WAF_ALLOW_DOMAINS=vmess.example.com,trojan.example.com
WAF_ALLOW_DOMAINS=
