# =============================================================================
# singbox-all 环境变量模板
#   复制为 .env 后按需修改: cp .env.example .env
#   注意: compose 使用 host 网络模式, conduitvpn 以 NETWORK_MODE=host 运行。
#         各服务监听地址 (NGINX_LISTEN / UI_HOST / LOCAL_PROXY_HOST) 默认均为
#         127.0.0.1 (仅本机可达), 不对公网暴露任何端口; 需要时可在下方按需放开。
# =============================================================================

# ---- vmess ----
VMESS_PORT=6601
VMESS_NAME=xiaonuo
VMESS_UUID=f011c012-5f1d-418c-9494-d24d77a9d8f9
VMESS_ALTER_ID=0
VMESS_WSPATH=/xiaonuo/vmess

# ---- trojan ----
TROJAN_PORT=6602
TROJAN_NAME=xiaonuo
TROJAN_PWD=ysyh!9Sky
TROJAN_WSPATH=/xiaonuo/trojan

# ---- conduitvpn 运行模式 ----
# host 网络模式下必须为 host (socket 标记路由, 从不改宿主机默认路由)
# 独立 bridge 网络时用 container (全隧道 redirect-gateway)
NETWORK_MODE=host

# ---- conduitvpn 管理台 (密码必须 >=16 字符) ----
UI_USER=admin
UI_PASSWORD=Chqmyg#2024Moon!
# 管理台监听地址: 默认 127.0.0.1 仅本机可达, 不暴露任何公网端口 (host 模式最安全).
#   外部访问方式: 通过 cloudflared 命名隧道把子域指向 http://127.0.0.1:8787
#   (见下方 TUNNEL_TOKEN / CF_TUNNEL_UI_HOSTNAME 说明). 如确需直接公网暴露, 改为 0.0.0.0 并自行配置防火墙.
UI_HOST=127.0.0.1

# ---- conduitvpn 本地代理 (sing-box 出站经此走住宅IP; 密码必须 >=16 字符) ----
# 仅供本机 sing-box 出站调用, 保持 127.0.0.1 即可 (无需外部访问)
LOCAL_PROXY_HOST=127.0.0.1
LOCAL_PROXY_PORT=7928
LOCAL_PROXY_USER=proxy
LOCAL_PROXY_PASS=Chqmyg#2024Moon!

# ---- sing-box 出站回落策略 ----
# none  : 只走 conduitvpn 住宅IP; VPNGate 不可用时连接失败, 不泄漏主机IP (默认)
# direct: 加入 direct + urltest; VPNGate 不可用时允许通过主机线路直连
#         ⚠️ direct 模式可能主动选择直连, 不保证一直使用住宅IP
SINGBOX_FALLBACK=none

# ---- hysteria2 关闭 (UDP 无法经 Cloudflare Tunnel; host 模式也不支持) ----
HY2_PORT=0

# ---- nginx 监听地址与端口 (host 网络模式) ----
# NGINX_LISTEN: 监听地址
#   127.0.0.1 : 仅本机可达, 公网走 cloudflared 隧道回源 (默认, 无需防火墙)
#   0.0.0.0   : 开放公网直连 (⚠️ 需自行配置防火墙; 直连时记得设置 LINK_DOMAIN)
NGINX_LISTEN=127.0.0.1
# NGINX_PORT: 对外监听端口, 与宿主机其他服务冲突时可改 (如 8080)
#   cloudflared 回源地址会自动跟随此端口, 无需另外配置
NGINX_PORT=80

# ---- cloudflared ----
# 留空: quick tunnel (随机 trycloudflare.com 域名, 每次重启变化)
# 填值: 命名隧道 (固定域名, 需在 Cloudflare Zero Trust 面板配置 ingress)
#
# 访问 conduitvpn 管理台 (UI_HOST=127.0.0.1 不开放公网时):
#   在 Cloudflare Zero Trust > 该隧道 > Public Hostname 增加一条 ingress:
#     - 代理流量: <你的域名>            -> http://127.0.0.1:80    (nginx 反代 vmess/trojan)
#     - 管理台:   admin.<你的域名>      -> http://127.0.0.1:8787  (conduitvpn UI)
#   建议再给管理台子域套一层 Cloudflare Access (邮箱/OTP) 做二次鉴权.
TUNNEL_TOKEN=

# ---- 链接生成域名 ----
# 留空: 自动从 cloudflared 日志抓取 quick tunnel 域名
# 填固定域名 (命名隧道时): 优先使用此值生成分享链接/订阅
LINK_DOMAIN=

# ---- WAF 放行域名 (逗号分隔, DetectionOnly 放行, 避免误拦代理流量) ----
# trycloudflare.com 已固定放行; 此处追加自定义域名, 例如:
# WAF_ALLOW_DOMAINS=vmess.example.com,trojan.example.com
WAF_ALLOW_DOMAINS=
